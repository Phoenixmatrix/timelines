{
  "model": "opus",
  "fallbackModel": ["sonnet"],
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "command -v gm >/dev/null 2>&1 && gm hook claude-code || true",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v gm >/dev/null 2>&1 && gm hook claude-code updates || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
