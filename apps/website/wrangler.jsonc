{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gitmatrix",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    // The API and git smart-HTTP endpoints must never fall through to index.html.
    "run_worker_first": ["/api/*", "/*.git/*"],
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "gitmatrix-dev",
      // There is no local Artifacts emulator, so dev talks to the real service.
      "remote": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitmatrix",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
