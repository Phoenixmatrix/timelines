{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "typecheck": "cf workers types && node ../../tools/agent/typecheck.ts -p tsconfig.app.json && node ../../tools/agent/typecheck.ts -p tsconfig.worker.json && node ../../tools/agent/typecheck.ts -p tsconfig.node.json",
    "cf-typegen": "cf workers types",
    "db:migrate": "cf d1 migrations apply 00000000000000000000000000000000 --local --persist-to .wrangler/state && cf d1 migrations apply 00000000000000000000000000000001 --local --persist-to .wrangler/state --dir registry/migrations",
    "deploy": "vp run build && cf deploy",
    "git:login": "node scripts/git-login.ts",
    "db:pending": "cf d1 migrations list 00000000000000000000000000000000 --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@gitmatrix/formats": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "diff": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "kysely": "catalog:",
    "kysely-d1": "catalog:",
    "mermaid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "react-router": "catalog:",
    "remark-gfm": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@gitmatrix/testing": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "cf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
