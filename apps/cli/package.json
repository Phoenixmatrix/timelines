{
  "name": "cli",
  "version": "0.1.0",
  "private": true,
  "description": "gm, the Timelines CLI (Rust). Scripts wrap cargo so `vp run -r` covers it.",
  "scripts": {
    "build": "cargo build --release",
    "test": "cargo test && node --test assets/claude-code-mod/tests/*.test.ts",
    "check": "cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "install-bin": "cargo install --path . --locked"
  }
}
